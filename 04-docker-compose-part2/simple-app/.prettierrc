{
  "trailingComma": "none",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "importOrder": [
    "^(.*/)?globals\\.scss$",
    "<THIRD_PARTY_MODULES>",
    "^@/.*",
    "^[./](?!.*\\.scss$).*",
    "^[./].*\\.scss$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports"
  ]
}